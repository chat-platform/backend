# Copy to .env for local use. Process environment values take precedence.
POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger
POSTGRES_DB=messenger
POSTGRES_DSN=postgres://messenger:messenger@localhost:5432/messenger?sslmode=disable
REDIS_ADDR=localhost:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
DEV_OTP_CODE=000000
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_ADD_SOURCE=false

# Local MinIO values used by docker-compose.local.yml.
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=chat-media
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
MEDIA_URL_TTL=5m
SESSION_TTL=24h
CORE_API_LISTEN_ADDR=:8081
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORE_API_GRPC_ADDR=:50052
CORE_API_METRICS_ADDR=:9091
CORE_API_HOST_PORT=8081
MESSAGE_SERVICE_GRPC_ADDR=:50051
MESSAGE_SERVICE_METRICS_ADDR=:9092
WS_GATEWAY_LISTEN_ADDR=:8080
WS_GATEWAY_METRICS_ADDR=:9094
WS_GATEWAY_HOST_PORT=8080
WS_CORE_API_GRPC_ADDR=core-api:50052
MESSAGE_SERVICE_ADDR=message-service:50051
NODE_ID=ws-1
WS_PATH=/ws
RELAY_METRICS_ADDR=:9093
RELAY_POLL_INTERVAL=250ms
RELAY_BATCH_SIZE=100
RELAY_WORKERS=2
RELAY_CLAIM_LEASE=30s
RELAY_RETRY_INTERVAL=10s
RELAY_RETRY_BATCH_SIZE=100
RELAY_SNAPSHOT_COUNT_CAP=1000
NOTIFICATION_METRICS_ADDR=:9095
NOTIFICATION_COALESCE_WINDOW=5s
GOOGLE_APPLICATION_CREDENTIALS=./.local/firebase-service-account.json
GOOGLE_CLOUD_PROJECT=
PROMETHEUS_URL=http://prometheus:9090

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password
