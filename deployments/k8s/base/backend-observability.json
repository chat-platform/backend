        "type": "prometheus",
        "uid": "backend-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "backend-prometheus"
          },
          "expr": "up{service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false
